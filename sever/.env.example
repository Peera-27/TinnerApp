MODE=development
PORT=8000

# Supabase — Dashboard > Connect > "Session pooler" (port 5432).
# NOT the Transaction pooler (6543), and NOT the direct connection (IPv6-only).
#   postgresql://postgres.<project-ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DB_POOL_MAX=10

JWT_SECRET=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only needed while running `bun run db:import`
MONGO_URI=

# Where the app is reachable from a browser. Password-reset links are built from
# this, so a stale value mails people a link to somewhere that cannot reset
# anything. Defaults to http://localhost:4200 when unset.
APP_URL=http://localhost:4200

# Mail delivery. Leave MAIL_PROVIDER empty in development: reset mail is printed
# to this terminal instead of being sent, which is enough to follow the link.
# Set it to "resend" in production and fill in the two below.
MAIL_PROVIDER=
RESEND_API_KEY=
# Must be a sender on a domain verified with Resend, e.g.
#   Tinner <no-reply@yourdomain.com>
# Resend's sandbox sender onboarding@resend.dev also works, but only delivers to
# the address that owns the Resend account.
MAIL_FROM=
